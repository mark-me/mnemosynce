{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask: Debug web app",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": [
                "--app",
                "src.web.app:create_app",
                "run",
                "--debug",
                "--reload"
            ],
            "env": {
                "APP_ENV": "development"
            },
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ]
}